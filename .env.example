# mail-agent secrets — copy to .env (git-ignored), fill real values, then:
#   sops --encrypt --age <AGE> --input-type dotenv --output-type dotenv .env > .env.enc
# Gmail App Password (needs 2FA on): myaccount.google.com > Security > App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
INVESTOR_PAN=ABCDE1234F
REGISTERED_EMAIL=you@gmail.com
# optional
HIMALAYA_CONFIG_PATH=config/himalaya-config.toml
DOWNLOAD_DIR=downloads
IMAP_POLL_SECONDS=30
IMAP_POLL_TIMEOUT=1800
